# Backend
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-in-local-env
JWT_EXPIRES_IN=1d
ADMIN_EMAIL_ALLOWLIST=

# PostgreSQL + pgvector
DB_HOST=localhost
DB_PORT=5433
DB_USER=jungle
DB_PASSWORD=jungle
DB_NAME=jungle_ai_mentor
TYPEORM_SYNC=true

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_WEB_SEARCH_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# production에서는 real만 허용됩니다. mock은 RAG_RUNTIME_ENV=demo 또는 local에서 명시적으로만 허용됩니다.
RAG_RUNTIME_ENV=local
RAG_EMBEDDING_MODE=real
RAG_EMBEDDING_DIMENSION=1536
RAG_EMBEDDING_VERSION=v1

# GitHub MCP adapter
GITHUB_TOKEN=
MCP_GITHUB_MODE=mock
